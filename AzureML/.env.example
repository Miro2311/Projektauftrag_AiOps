# Kopieren nach AzureML/.env und ausfüllen (.env wird NICHT committet)
# Azure ML Studio -> Endpoints -> <dein Endpoint> -> Consume
AZUREML_SCORING_URI=https://<endpoint-name>.<region>.inference.ml.azure.com/score
AZUREML_API_KEY=<primary-key>
# Optional, falls mehrere Deployments am Endpoint hängen
AZUREML_DEPLOYMENT=

# Nur für Variante B (SDK)
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZUREML_WORKSPACE=
AZUREML_ENDPOINT_NAME=
